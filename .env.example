# ── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
# Alternatively: claude-3-5-sonnet-20241022

# ── Vision (image captioning) ─────────────────────────
VISION_MODEL=gpt-4o
LOCAL_VISION=false              # set true to use LLaVA via Ollama (free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b

# ── Embeddings ────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
# Local alternative: BAAI/bge-m3 (set LOCAL_EMBEDDINGS=true)
LOCAL_EMBEDDINGS=false

# ── Vector store ──────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=omnilens_default

# ── Chunking ──────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Retrieval ─────────────────────────────────────────
TOP_K=10
RERANK_TOP_K=3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── File storage ──────────────────────────────────────
FILE_STORE=local                # local | s3
FILE_STORE_PATH=./uploaded_files
# If s3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=omnilens-files
AWS_REGION=ap-south-1
